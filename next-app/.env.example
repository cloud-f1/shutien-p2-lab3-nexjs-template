# =============================================================================
# .env.example — Environment Variable Matrix / 環境變數矩陣
#
# Copy to .env.local for local development:  cp .env.example .env.local
# Zeabur: set vars in the Zeabur dashboard BEFORE triggering a build.
# GCP Cloud Run: pass as --set-env-vars (runtime) or --build-arg (build-time).
#
# ┌─────────────────────────────────────────────────────────────────────────┐
# │  NEXT_PUBLIC_* vars are BAKED INTO THE BUNDLE AT BUILD TIME.            │
# │  Changing them after the build has NO effect — you must rebuild.        │
# │  All other vars are runtime secrets injected after the image is built.  │
# └─────────────────────────────────────────────────────────────────────────┘
# =============================================================================


# -----------------------------------------------------------------------------
# [BUILD-TIME] Public App Config / 公開應用程式設定
# These are embedded in the client-side JS bundle at `next build` time.
# Set them in Zeabur dashboard (or Cloud Run build step) BEFORE building.
# -----------------------------------------------------------------------------

# ⭐ SINGLE REBRAND KNOB — display name used across logo, nav, footer, sidebar,
# and the document <title>. Set this once to rebrand the whole template; leave
# unset to keep the default "AI App Template". Baked at build time — rebuild after
# changing. 一鍵改名：設定後即可重塑整個模板品牌（留空則維持預設名稱）。
NEXT_PUBLIC_APP_NAME=AI App Template

# Optional default meta description (zh-Hant). Falls back to a sensible default.
# 選填：預設的 meta description（留空則使用內建描述）
# NEXT_PUBLIC_APP_DESCRIPTION=

# Canonical public URL of the app (used in email links, ECPay callbacks, etc.)
# 應用程式的公開 URL（用於電子郵件連結、ECPay 回呼等）
NEXT_PUBLIC_APP_URL=https://your-app.zeabur.app

# Set to "true" to show demo quick-login buttons (admin / editor / viewer).
# Set to "false" (or omit) for production so credential literals tree-shake out.
# 設為 "true" 顯示示範快速登入按鈕；正式環境請設為 "false"
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=false


# -----------------------------------------------------------------------------
# [RUNTIME] Auth.js v5 / 認證設定
# These are read at server startup — never baked into the bundle.
# Generate AUTH_SECRET with:  npx auth secret
# -----------------------------------------------------------------------------

# 32+ byte random secret — used to sign session cookies and JWTs.
# 32 位元以上的隨機金鑰，用於簽署 session cookie 和 JWT
AUTH_SECRET=replace-me-with-a-32-char-random-secret

# Full public URL (same as NEXT_PUBLIC_APP_URL but runtime-only).
# Required when running behind a reverse proxy (Zeabur, Cloud Run, nginx).
# 應用程式完整 URL（執行期版本，在反向代理後必填）
AUTH_URL=https://your-app.zeabur.app

# Allow Auth.js to trust the X-Forwarded-Host header from the proxy.
# 允許 Auth.js 信任來自代理的 X-Forwarded-Host header
AUTH_TRUST_HOST=true

# [RUNTIME] Persistent login lockout (E355) — DEFAULT: ON.
# 5 consecutive wrong passwords lock the account for 15 minutes. Unlike the
# in-memory throttle in lib/rate-limit.ts, this lock is stored on the user row
# (users.failed_login_count / users.locked_until) so it SURVIVES a restart.
# No NEXT_PUBLIC_ prefix ⇒ server-side runtime env: flip it per service and it
# takes effect on the next request, with NO rebuild.
# Set to false / 0 / off to disable. Disabling is a COMPLETE no-op: nothing is
# counted, nothing is locked, and no DB write happens — AND any already-stored
# `locked_until` stops blocking, so it doubles as the escape hatch for letting a
# locked-out user back in immediately. The column values are kept, so
# re-enabling restores the original behaviour.
# 持久登入鎖定（預設開啟）。連續 5 次密碼錯誤 → 鎖定 15 分鐘，重啟後仍有效。
# 設為 false 會完全停用（不計數、不寫 DB），且「既有的鎖定也立即解除」——
# 這正是它作為逃生口的用途；欄位值保留，重新開啟後恢復原語意。
# ENABLE_LOGIN_LOCKOUT=true


# -----------------------------------------------------------------------------
# [RUNTIME] Database / 資料庫
# Neon, Supabase, or any PostgreSQL-compatible connection string.
# -----------------------------------------------------------------------------

# PostgreSQL connection string (connection pooling URL recommended for serverless).
# 建議使用 connection pooling URL（如 Neon / Supabase pooler）
DATABASE_URL=postgresql://user:password@host:5432/dbname


# -----------------------------------------------------------------------------
# [RUNTIME] Google OAuth (optional / 選填)
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: ${AUTH_URL}/api/auth/callback/google
# -----------------------------------------------------------------------------

# Google OAuth client ID / Google OAuth 用戶端 ID
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com

# Google OAuth client secret / Google OAuth 用戶端密鑰
AUTH_GOOGLE_SECRET=your-google-client-secret


# -----------------------------------------------------------------------------
# [RUNTIME] GitHub OAuth (optional / 選填)
# Register an OAuth app at: https://github.com/settings/developers
#   → "New OAuth App"
#   • Homepage URL:               ${AUTH_URL}
#   • Authorization callback URL: ${AUTH_URL}/api/auth/callback/github
# Leave both unset to disable the GitHub login button (boot/build still work).
# 在 GitHub 開發者設定建立 OAuth App；回呼網址須為上方 callback URL。
# 兩者皆留空則停用 GitHub 登入按鈕（不影響啟動 / 建置）。
# -----------------------------------------------------------------------------

# GitHub OAuth client ID / GitHub OAuth 用戶端 ID
AUTH_GITHUB_ID=your-github-client-id

# GitHub OAuth client secret / GitHub OAuth 用戶端密鑰
AUTH_GITHUB_SECRET=your-github-client-secret


# -----------------------------------------------------------------------------
# [RUNTIME] SMTP / Email (optional / 選填)
# Defaults to localhost:1025 (Mailpit) when unset — safe for local dev.
# -----------------------------------------------------------------------------

# SMTP server hostname / SMTP 伺服器主機名稱
SMTP_HOST=smtp.your-provider.com

# SMTP port — 587 for STARTTLS, 465 for SSL, 1025 for local Mailpit
# SMTP 連接埠 — 587 (STARTTLS), 465 (SSL), 1025 (本地 Mailpit)
SMTP_PORT=587

# Enable TLS for port 465; leave unset or "false" for STARTTLS / plaintext
# 啟用 TLS（用於 465 埠）；STARTTLS 或明文連線請留空或設為 "false"
SMTP_SECURE=false

# SMTP login credentials (omit both for unauthenticated relay / Mailpit)
# SMTP 登入憑證（Mailpit 等無驗證中繼請省略）
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password

# From address shown in outgoing emails / 寄件者地址
EMAIL_FROM=noreply@your-domain.com


# -----------------------------------------------------------------------------
# [RUNTIME] Sales — 一次性購買 / One-time products (E327)
# -----------------------------------------------------------------------------
# The unified one-time checkout (createOneTimeCheckout) and its settlement routes
# resolve the gateway from BILLING_PROVIDER below — the SAME knob subscriptions
# use. The LAUNCH gateway for one-time sales is ECPay 綠界 (user decision):
#   • For a sales deployment set  BILLING_PROVIDER=ecpay  and fill in the ECPay
#     credentials in the ECPay section below.
#   • Stripe remains the CODE-LEVEL resolver default (do NOT change the default in
#     resolver.ts) — it is what runs with no env set, e.g. in CI/tests.
# Supported one-time gateways today: stripe, ecpay, newebpay (藍新 MPG, E329).
# The seed ships one demo product (slug: nextjs-course) so /p/nextjs-course works
# once E326's sales page lands.
# -----------------------------------------------------------------------------


# -----------------------------------------------------------------------------
# [RUNTIME] Billing — Stripe (optional / 選填)
# Install module: npx shadcn@latest add @saas/billing-stripe
# Set BILLING_PROVIDER=stripe (default when module is installed).
# -----------------------------------------------------------------------------

# Which billing provider to use: "stripe" | "ecpay" | "newebpay" (default: "stripe")
# 使用的金流供應商（預設 "stripe"；newebpay 僅支援一次性付款）
BILLING_PROVIDER=stripe

# Stripe secret key (starts with sk_live_ or sk_test_)
# Stripe 密鑰（正式 sk_live_ / 測試 sk_test_）
STRIPE_SECRET_KEY=sk_test_replace_me

# Stripe webhook signing secret (from the Stripe dashboard → Webhooks)
# Stripe webhook 簽名密鑰（從 Stripe 控制台 → Webhooks 取得）
STRIPE_WEBHOOK_SECRET=whsec_replace_me


# -----------------------------------------------------------------------------
# [RUNTIME] Billing — ECPay 綠界 (optional / 選填)
# Install module: npx shadcn@latest add @saas/billing-ecpay
# Set BILLING_PROVIDER=ecpay when using ECPay.
# Obtain credentials at: https://www.ecpay.com.tw/
# -----------------------------------------------------------------------------

# ECPay merchant ID / 綠界特店編號
ECPAY_MERCHANT_ID=your-ecpay-merchant-id

# ECPay hash key / 綠界 HashKey
ECPAY_HASH_KEY=your-ecpay-hash-key

# ECPay hash IV / 綠界 HashIV
ECPAY_HASH_IV=your-ecpay-hash-iv

# ECPay API base URL — staging vs production
# 綠界 API 端點 — 測試環境 vs 正式環境
# Staging:    https://payment-stage.ecpay.com.tw  (default)
# Production: https://payment.ecpay.com.tw
ECPAY_API_BASE_URL=https://payment-stage.ecpay.com.tw

# Days before subscription expiry to trigger renewal attempt (default: 7)
# 訂閱到期前幾天觸發續訂（預設 7 天）
ECPAY_RENEWAL_THRESHOLD=7


# -----------------------------------------------------------------------------
# [RUNTIME] Billing — 藍新 NewebPay MPG 幕前支付 (optional / 選填, one-time only)
# Set BILLING_PROVIDER=newebpay to use 藍新 for one-time product checkout (E329).
# 藍新 is a ONE-TIME-only gateway here (MPG 幕前支付) — subscriptions must stay on
# stripe or ecpay. Obtain credentials in the 藍新金流商店後台:
#   會員中心 → 商店管理 → 取得「商店代號 MerchantID / HashKey / HashIV」
# 測試站(sandbox) 與 正式站(production) 使用「不同」的一組金鑰，勿混用。
# -----------------------------------------------------------------------------

# 藍新 商店代號 / NewebPay MerchantID
NEWEBPAY_MERCHANT_ID=your-newebpay-merchant-id

# 藍新 HashKey — 32 碼字串（AES-256 金鑰，長度必須剛好 32）
NEWEBPAY_HASH_KEY=your-newebpay-hash-key-32-chars

# 藍新 HashIV — 16 碼字串（AES-CBC IV，長度必須剛好 16）
NEWEBPAY_HASH_IV=your-newebpay-iv

# Environment toggle: leave unset/empty for the 測試站 (sandbox, default).
# Set NEWEBPAY_SANDBOX=false to hit the 正式站 (production) gateway.
#   sandbox:    https://ccore.newebpay.com/MPG/mpg_gateway  (default)
#   production: https://core.newebpay.com/MPG/mpg_gateway
NEWEBPAY_SANDBOX=true

# Optional explicit gateway base URL override (wins over NEWEBPAY_SANDBOX).
# NEWEBPAY_API_BASE_URL=https://ccore.newebpay.com


# -----------------------------------------------------------------------------
# [RUNTIME] Observability — Sentry (optional / 選填)
# When SENTRY_DSN is unset, instrumentation.ts is a complete no-op and
# @sentry/nextjs is never initialised — safe for zero-config deployments.
# Obtain your DSN at: https://sentry.io → Settings → Projects → Client Keys
# -----------------------------------------------------------------------------

# Sentry Data Source Name (DSN) — leave unset to disable Sentry entirely
# Sentry DSN — 留空則完全停用 Sentry
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# -----------------------------------------------------------------------------
# [TOOLING] @saas shadcn registry origin / @saas 註冊表來源
# Where `npx shadcn add @saas/<module>` fetches modules from. THIS app serves
# the registry at /r/* — so the origin must point at a RUNNING instance of it.
#   • Local install:   run `pnpm dev` (or `pnpm build && pnpm start`) and use
#                      the default below (http://localhost:3000).
#   • Deployed registry: set this to your deployed domain, e.g.
#                      SAAS_REGISTRY_URL=https://your-app.zeabur.app
# components.json expands `${SAAS_REGISTRY_URL}/r`; shadcn errors with a clear
# "Missing environment variables" message if it is unset (no silent localhost
# fallback). NOTE: shadcn's `${VAR}` token does NOT support `:-default` syntax,
# so this var must be set whenever you run `npx shadcn add @saas/...`.
# -----------------------------------------------------------------------------

SAAS_REGISTRY_URL=http://localhost:3000
