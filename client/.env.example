VITE_API_URL=http://localhost:8080
VITE_GOOGLE_CLIENT_ID=your-google-client-id
# ─── Observability (E159) ──────────────────────────────────────
# Sentry browser DSN — leave empty to disable. Production builds with
# an empty DSN log a console.warn (they do NOT crash). Set this in
# Zeabur BEFORE the client build runs (VITE_* values are baked at build).
VITE_SENTRY_DSN=
# Build-time commit SHA — used as the Sentry `release` tag so stack
# traces deep-link to the exact commit. Recommended in CI:
#   VITE_GIT_SHA=$(git rev-parse --short HEAD) pnpm build
VITE_GIT_SHA=
