{
  "name": "ai-coding-template-client",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:unit": "vitest run --reporter=dot",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "openapi:bundle": "redocly bundle ../docs/openapi/openapi.yaml -o ../docs/openapi.yaml",
    "generate:types": "redocly bundle ../docs/openapi/openapi.yaml --output /tmp/openapi-bundled.yaml && openapi-typescript /tmp/openapi-bundled.yaml --output src/api/types.ts",
    "size": "size-limit"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@sentry/react": "^10.43.0",
    "@tanstack/react-query": "^5.62.0",
    "axios": "^1.16.1",
    "i18next": "^25.8.18",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.1",
    "react-i18next": "^16.5.8",
    "react-router-dom": "^6.28.0",
    "recharts": "^3.8.0",
    "zod": "^3.24.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.49.1",
    "@redocly/cli": "^2.21.1",
    "@size-limit/file": "^11.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.1.0",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.16.0",
    "jsdom": "^28.1.0",
    "msw": "^2.7.0",
    "openapi-typescript": "^7.4.4",
    "postcss": "^8.5.8",
    "prettier": "^3.4.2",
    "size-limit": "^11.0.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.2",
    "vite": "^7.3.5",
    "vitest": "^4.1.0"
  }
}
