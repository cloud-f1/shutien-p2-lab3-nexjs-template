# ─── AI-Coding-Template — Local Development Defaults ─────────
# Copy to server/.env:  cp .env.local server/.env
# Then run: make go

# ─── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://saas_user:saas_pass@localhost:5432/saas_dev

# ─── JWT Secrets ──────────────────────────────────────────────
# REQUIRED — `make go` auto-generates random values if you use
#            `scripts/generate-env.sh`. Replace these placeholders.
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING
REFRESH_SECRET_KEY=CHANGE_ME_REFRESH_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── Email ────────────────────────────────────────────────────
# "console" prints to stdout (no external service needed in dev)
# Options: console | mailgun | zeabur
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@example.com
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=
# ZEABUR_EMAIL_API_KEY=

# ─── Google OAuth2 ────────────────────────────────────────────
# Optional — uncomment to enable Google sign-in
# Get credentials at https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=your-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-secret

# ─── GitHub OAuth2 ────────────────────────────────────────────
# Optional — uncomment to enable GitHub sign-in
# Get credentials at https://github.com/settings/developers
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-secret

# ─── Stripe Billing ───────────────────────────────────────────
# Optional — uncomment to enable Stripe billing
# Get keys at https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Monitoring ───────────────────────────────────────────────
# Optional — leave empty to disable Sentry error tracking
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
APP_VERSION=0.1.0

# ─── Logging ──────────────────────────────────────────────────
# "console" for human-readable, "json" for structured (production)
LOG_FORMAT=console

# ─── App ──────────────────────────────────────────────────────
DEBUG=true
ENVIRONMENT=development
ALLOWED_ORIGINS_STR=http://localhost:3000,http://localhost:5173
RATE_LIMIT_AUTH=15/minute
RATE_LIMIT_GENERAL=200/minute

# ─── Session Cleanup ─────────────────────────────────────────
SESSION_CLEANUP_INTERVAL_MINUTES=60
SESSION_RETENTION_DAYS=7
