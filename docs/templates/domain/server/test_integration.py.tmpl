async def test_delete_{{SNAKE}}(client: AsyncClient):
    data = await _register_and_login(client, "{{SNAKE}}9@test.com")
    headers = _auth(data["access_token"])

    create_resp = await client.post("/{{KEBAB_PLURAL}}/", json={{UPPER_SNAKE}}_DATA, headers=headers)
    item_id = create_resp.json()["id"]

