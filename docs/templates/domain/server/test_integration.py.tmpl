async def test_list_{{SNAKE_PLURAL}}_only_own(client: AsyncClient):
    data1 = await _register_and_login(client, "{{SNAKE}}3a@test.com")
    data2 = await _register_and_login(client, "{{SNAKE}}3b@test.com")

    # User 1 creates an item
    await client.post(
        "/{{KEBAB_PLURAL}}/", json={{UPPER_SNAKE}}_DATA, headers=_auth(data1["access_token"])
    )
    # User 2 creates an item
    await client.post(
        "/{{KEBAB_PLURAL}}/",
        json={{UPPER_SNAKE}}_DATA,
        headers=_auth(data2["access_token"]),
    )

    # User 1 should only see their item
    resp = await client.get("/{{KEBAB_PLURAL}}/", headers=_auth(data1["access_token"]))
    assert resp.status_code == 200
    body = resp.json()
    assert body["total"] == 1


async def test_list_{{SNAKE_PLURAL}}_pagination(client: AsyncClient):
    data = await _register_and_login(client, "{{SNAKE}}4@test.com")
    headers = _auth(data["access_token"])

    # Create 3 items
    for i in range(3):
        item_data = {**{{UPPER_SNAKE}}_DATA}
        {{#FIELDS_FIRST}}
        item_data["{{field_name}}"] = {{field_test_value_indexed}}
        {{/FIELDS_FIRST}}
        await client.post("/{{KEBAB_PLURAL}}/", json=item_data, headers=headers)

    # Page 1, size 2
    resp = await client.get("/{{KEBAB_PLURAL}}/?page=1&page_size=2", headers=headers)
    body = resp.json()
    assert body["total"] == 3
    assert len(body["items"]) == 2
    assert body["page"] == 1

    # Page 2, size 2
    resp2 = await client.get("/{{KEBAB_PLURAL}}/?page=2&page_size=2", headers=headers)
    body2 = resp2.json()
    assert len(body2["items"]) == 1


