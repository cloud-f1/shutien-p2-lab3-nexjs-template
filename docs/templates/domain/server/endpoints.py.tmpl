"""{{PASCAL_PLURAL}} CRUD endpoints."""

import logging
import uuid

from fastapi import APIRouter, Depends, HTTPException, Query, Request
from sqlalchemy import func, select
from sqlalchemy.ext.asyncio import AsyncSession

from app.core.auth import current_active_user
from app.core.config import settings
from app.core.limiter import limiter
from app.db.session import get_db
from app.domains.{{SNAKE_PLURAL}}.models import {{PASCAL}}
from app.domains.{{SNAKE_PLURAL}}.schemas import {{PASCAL}}Create, {{PASCAL}}Read, {{PASCAL}}Update
from app.models.user import User

logger = logging.getLogger(__name__)

router = APIRouter()


@router.post("/", response_model={{PASCAL}}Read, status_code=201)
@limiter.limit(settings.RATE_LIMIT_GENERAL)
async def create_{{SNAKE}}(
    request: Request,
    body: {{PASCAL}}Create,
    user: User = Depends(current_active_user),
    db: AsyncSession = Depends(get_db),
):
    item = {{PASCAL}}(**body.model_dump(), user_id=user.id)
    db.add(item)
    await db.commit()
    await db.refresh(item)
    logger.info("create_{{SNAKE}}", extra={"user_id": str(user.id), "{{SNAKE}}_id": str(item.id)})
    return item


@router.get("/")
@limiter.limit(settings.RATE_LIMIT_GENERAL)
async def list_{{SNAKE_PLURAL}}(
    request: Request,
    page: int = Query(1, ge=1),
    page_size: int = Query(20, ge=1, le=100),
    user: User = Depends(current_active_user),
    db: AsyncSession = Depends(get_db),
):
    base = select({{PASCAL}}).where({{PASCAL}}.user_id == user.id)
    total_result = await db.execute(select(func.count()).select_from(base.subquery()))
    total = total_result.scalar() or 0

    result = await db.execute(
        base.order_by({{PASCAL}}.created_at.desc()).offset((page - 1) * page_size).limit(page_size)
    )
    items = [{{PASCAL}}Read.model_validate(p) for p in result.scalars().all()]

    pages = (total + page_size - 1) // page_size if total > 0 else 0
    return {"items": items, "total": total, "page": page, "page_size": page_size, "pages": pages}


@router.get("/{{{SNAKE}}_id}", response_model={{PASCAL}}Read)
@limiter.limit(settings.RATE_LIMIT_GENERAL)
async def get_{{SNAKE}}(
    {{SNAKE}}_id: uuid.UUID,
    request: Request,
    user: User = Depends(current_active_user),
    db: AsyncSession = Depends(get_db),
):
    result = await db.execute(
        select({{PASCAL}}).where({{PASCAL}}.id == {{SNAKE}}_id, {{PASCAL}}.user_id == user.id)
    )
    item = result.scalar_one_or_none()
    if item is None:
        raise HTTPException(status_code=404, detail="{{UPPER_SNAKE}}_NOT_FOUND")
    return item


@router.patch("/{{{SNAKE}}_id}", response_model={{PASCAL}}Read)
@limiter.limit(settings.RATE_LIMIT_GENERAL)
async def update_{{SNAKE}}(
    {{SNAKE}}_id: uuid.UUID,
    body: {{PASCAL}}Update,
    request: Request,
    user: User = Depends(current_active_user),
    db: AsyncSession = Depends(get_db),
):
    result = await db.execute(
        select({{PASCAL}}).where({{PASCAL}}.id == {{SNAKE}}_id, {{PASCAL}}.user_id == user.id)
    )
    item = result.scalar_one_or_none()
    if item is None:
        raise HTTPException(status_code=404, detail="{{UPPER_SNAKE}}_NOT_FOUND")

    update_data = body.model_dump(exclude_unset=True)
    for key, value in update_data.items():
        setattr(item, key, value)

    await db.commit()
    await db.refresh(item)
    return item


@router.delete("/{{{SNAKE}}_id}", status_code=204)
@limiter.limit(settings.RATE_LIMIT_GENERAL)
async def delete_{{SNAKE}}(
    {{SNAKE}}_id: uuid.UUID,
    request: Request,
    user: User = Depends(current_active_user),
    db: AsyncSession = Depends(get_db),
):
    result = await db.execute(
        select({{PASCAL}}).where({{PASCAL}}.id == {{SNAKE}}_id, {{PASCAL}}.user_id == user.id)
    )
    item = result.scalar_one_or_none()
    if item is None:
        raise HTTPException(status_code=404, detail="{{UPPER_SNAKE}}_NOT_FOUND")

    await db.delete(item)
    await db.commit()
    return None
