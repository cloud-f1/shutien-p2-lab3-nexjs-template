import { useState } from "react";
import { extractApiDetail } from "../../api/errors";
import {
  use{{PASCAL_PLURAL}}List,
  use{{PASCAL}}Create,
  use{{PASCAL}}Update,
  use{{PASCAL}}Delete,
} from "../../hooks/use{{PASCAL_PLURAL}}";
import type { {{PASCAL}}Read, {{PASCAL}}Create } from "../../schemas/{{SNAKE}}";
import "./{{PASCAL_PLURAL}}.css";

export default function {{PASCAL_PLURAL}}Page() {
  const [page, setPage] = useState(1);
  const [selectedItem, setSelectedItem] = useState<{{PASCAL}}Read | null>(null);
  const [formError, setFormError] = useState<string | null>(null);
  const [showForm, setShowForm] = useState(false);

  const { data, isLoading, isError } = use{{PASCAL_PLURAL}}List({ page, page_size: 20 });
  const createMutation = use{{PASCAL}}Create();
  const updateMutation = use{{PASCAL}}Update();
  const deleteMutation = use{{PASCAL}}Delete();

  const handleCreate = (formData: {{PASCAL}}Create) => {
    setFormError(null);
    createMutation.mutate(formData, {
      onSuccess: () => {
        setShowForm(false);
      },
      onError: (err) => {
        setFormError(extractApiDetail(err) || "Failed to create {{SNAKE}}.");
      },
    });
  };

  const handleUpdate = (formData: {{PASCAL}}Create) => {
    if (!selectedItem) return;
    setFormError(null);
    updateMutation.mutate(
      { id: selectedItem.id, data: formData },
      {
        onSuccess: () => {
          setShowForm(false);
          setSelectedItem(null);
        },
        onError: (err) => {
          setFormError(extractApiDetail(err) || "Failed to update {{SNAKE}}.");
        },
      },
    );
  };

  const handleDelete = (id: string) => {
    deleteMutation.mutate(id, {
      onSuccess: () => {
        setSelectedItem(null);
      },
    });
  };

  if (isLoading) {
    return (
      <div className="{{KEBAB_PLURAL}}-loading" role="status" aria-live="polite">
        Loading {{SNAKE_PLURAL}}...
      </div>
    );
  }

  if (isError) {
    return (
      <div className="{{KEBAB_PLURAL}}-error" role="alert">
        Failed to load {{SNAKE_PLURAL}}. Please try again.
      </div>
    );
  }

  return (
    <div className="{{KEBAB_PLURAL}}-page">
      <div className="{{KEBAB_PLURAL}}-header">
        <h2>{{PASCAL_PLURAL}} ({data?.total ?? 0})</h2>
        <button
          className="btn btn-primary"
          onClick={() => {
            setSelectedItem(null);
            setFormError(null);
            setShowForm(true);
          }}
        >
          + Add {{PASCAL}}
        </button>
      </div>

      {data && data.items.length === 0 ? (
        <div className="{{KEBAB_PLURAL}}-empty">
          <div className="{{KEBAB_PLURAL}}-empty-title">No {{SNAKE_PLURAL}} yet</div>
          <div className="{{KEBAB_PLURAL}}-empty-text">
            Create your first {{SNAKE}} to get started.
          </div>
        </div>
      ) : (
        <>
          <div className="{{KEBAB_PLURAL}}-table-wrap">
            <table className="{{KEBAB_PLURAL}}-table">
              <thead>
                <tr>
                  {{#FIELDS}}
                  <th>{{field_label}}</th>
                  {{/FIELDS}}
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                {data?.items.map((item) => (
                  <tr key={item.id}>
                    {{#FIELDS}}
                    <td>{String(item.{{field_name}} ?? "—")}</td>
                    {{/FIELDS}}
                    <td>
                      <button
                        className="btn btn-sm"
                        onClick={() => {
                          setSelectedItem(item);
                          setFormError(null);
                          setShowForm(true);
                        }}
                      >
                        Edit
                      </button>
                      <button
                        className="btn btn-sm btn-danger"
                        onClick={() => handleDelete(item.id)}
                      >
                        Delete
                      </button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          {data && data.pages > 1 && (
            <div className="{{KEBAB_PLURAL}}-pagination">
              <button
                className="btn btn-sm"
                disabled={page <= 1}
                onClick={() => setPage((p) => p - 1)}
              >
                Previous
              </button>
              <span className="{{KEBAB_PLURAL}}-pagination-info">
                Page {page} of {data.pages}
              </span>
              <button
                className="btn btn-sm"
                disabled={page >= data.pages}
                onClick={() => setPage((p) => p + 1)}
              >
                Next
              </button>
            </div>
          )}
        </>
      )}

      {showForm && (
        <div className="{{KEBAB_PLURAL}}-modal-overlay">
          <div className="{{KEBAB_PLURAL}}-modal">
            <h3 className="{{KEBAB_PLURAL}}-modal-title">
              {selectedItem ? "Edit {{PASCAL}}" : "Add {{PASCAL}}"}
            </h3>
            {formError && (
              <div className="form-error" role="alert">
                {formError}
              </div>
            )}
            {/* Form fields are expanded by the agent during generation */}
            <div className="{{KEBAB_PLURAL}}-modal-actions">
              <button
                className="btn"
                onClick={() => {
                  setShowForm(false);
                  setFormError(null);
                }}
              >
                Cancel
              </button>
              <button
                className="btn btn-primary"
                disabled={createMutation.isPending || updateMutation.isPending}
              >
                {selectedItem ? "Update {{PASCAL}}" : "Add {{PASCAL}}"}
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}
