# =============================================================================
# deploy/.env.deploy.example — DEPLOY-TIME variables
#
#   cp deploy/.env.deploy.example deploy/.env.deploy   # then fill in the blanks
#
# This file holds the *deploy-time* knobs that the Makefile deploy targets
# (`make image`, `make deploy-gcp`, `make db-migrate-prod`) source (project /
# region / registry / service / Cloud SQL / target DATABASE_URL). It is NOT the
# app's runtime env — that lives in next-app/.env.local (local) and in the cloud
# provider's env/secret store (cloud). See env-parity note at bottom.
#
#   • deploy/.env.deploy           → git-IGNORED (real values, keep secrets here)
#   • deploy/.env.deploy.example   → git-TRACKED (this template, NO secrets)
#
# Everything wrapped in ${PLACEHOLDER} is a value YOU fill in.
# =============================================================================


# -----------------------------------------------------------------------------
# Common — build / image
# -----------------------------------------------------------------------------

# Image tag. Leave blank to let `make image` derive it from the git short SHA
# (recommended — gives every build an immutable, traceable tag).
# IMAGE_TAG=

# Build platform for the runtime image. Cloud Run + Zeabur both run linux/amd64.
# Keep this even on an Apple-Silicon (arm64) Mac — `make image` builds amd64.
DEPLOY_PLATFORM=linux/amd64


# -----------------------------------------------------------------------------
# Road 1 — Zeabur (primary — see the `zeabur-deploy` skill + deploy/deploy-zeabur.sh)
# -----------------------------------------------------------------------------

# The Zeabur project to deploy into. If you already ran `zeabur context set`
# this can stay blank (the CLI uses the saved context). Otherwise set the name.
ZEABUR_PROJECT=${ZEABUR_PROJECT}

# The Zeabur service name for the Next.js app (matches deploy/config.json → "web").
ZEABUR_SERVICE=web


# -----------------------------------------------------------------------------
# Road 2 — GCP Cloud Run + Cloud SQL (`make deploy-gcp`)
# -----------------------------------------------------------------------------

# GCP project + region.
GCP_PROJECT_ID=${GCP_PROJECT_ID}            # e.g. my-product-prod
GCP_REGION=${GCP_REGION}                    # e.g. asia-east1

# Artifact Registry docker repo (created once; see the `deploy-config` skill).
GCP_AR_REPO=${GCP_AR_REPO}                  # e.g. my-product-images
GCP_IMAGE_NAME=next-app

# Cloud Run service name.
GCP_SERVICE_NAME=${GCP_SERVICE_NAME}        # e.g. my-product-web

# Cloud SQL (Postgres) instance + database/user.
GCP_SQL_INSTANCE=${GCP_SQL_INSTANCE}        # e.g. my-product-db
GCP_DB_NAME=${GCP_DB_NAME}                  # e.g. my_product
GCP_DB_USER=${GCP_DB_USER}                  # e.g. my_product_user

# Derived (do NOT edit) — the fully-qualified Cloud SQL connection name.
# Format: PROJECT:REGION:INSTANCE. Used by --add-cloudsql-instances.
# GCP_SQL_CONN is computed by the Makefile as ${GCP_PROJECT_ID}:${GCP_REGION}:${GCP_SQL_INSTANCE}.


# -----------------------------------------------------------------------------
# Target DATABASE_URL for `make db-migrate-prod` / migrate-on-deploy
# -----------------------------------------------------------------------------
#
# This is the connection string drizzle-kit runs migrations against. Keep the
# real value in deploy/.env.deploy (git-ignored) or export it ad-hoc — NEVER
# commit a live credential.
#
#   • Cloud SQL via the Cloud SQL Auth Proxy (recommended for `make db-migrate-prod`
#     from your laptop) — start the proxy, then point at 127.0.0.1:
#       cloud-sql-proxy ${GCP_PROJECT_ID}:${GCP_REGION}:${GCP_SQL_INSTANCE} &
#       PROD_DATABASE_URL=postgresql://${GCP_DB_USER}:<PASSWORD>@127.0.0.1:5432/${GCP_DB_NAME}
#
#   • Cloud SQL via unix socket (what Cloud Run itself uses at runtime — the
#     migrate Cloud Run Job reads this from Secret Manager, not from here):
#       postgresql://USER:PASS@localhost/DBNAME?host=/cloudsql/PROJECT:REGION:INSTANCE
#
#   • Zeabur managed Postgres — copy DATABASE_URL from the Postgres service's
#     Variables tab (it exposes a public host for external migrate runs).
#
PROD_DATABASE_URL=${PROD_DATABASE_URL}


# -----------------------------------------------------------------------------
# Build-time NEXT_PUBLIC_* (baked into the JS bundle — must be set at build)
# -----------------------------------------------------------------------------
#
# These are NOT runtime secrets. `make image` / `make deploy-gcp` pass them as
# --build-arg. Changing them after a build has NO effect — rebuild to apply.
#
NEXT_PUBLIC_APP_URL=${NEXT_PUBLIC_APP_URL}  # e.g. https://my-product-web-xxxx.a.run.app
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=false         # production: never ship demo quick-login


# =============================================================================
# ENV PARITY — the single source of truth is next-app/.env.example
# -----------------------------------------------------------------------------
# The APP's RUNTIME vars (AUTH_SECRET, AUTH_URL, AUTH_TRUST_HOST, DATABASE_URL,
# SMTP_*, NEXT_PUBLIC_*) are defined ONCE in next-app/.env.example. To stay in
# sync, set the SAME KEYS in every environment:
#
#   local  → next-app/.env.local           (make local-env generates a starter)
#   Zeabur → Zeabur dashboard / `zeabur variable env -f .env.zeabur -n web`
#   GCP    → Secret Manager (secrets) + --set-env-vars (non-secret runtime)
#
# This deploy file only adds the *deploy-time* knobs above; it does not replace
# next-app/.env.example. When you add a new app env var, add it there FIRST.
# =============================================================================
