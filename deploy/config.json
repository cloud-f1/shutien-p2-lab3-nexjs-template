{
  "project": {
    "name": "my-saas",
    "display_name": "My SaaS",
    "github_repo": "your-org/your-repo"
  },
  "service": {
    "name": "web",
    "root": "next-app",
    "port": 3000,
    "dockerfile": "next-app/Dockerfile"
  },
  "zeabur": {
    "service": "web",
    "postgres_service": "postgres"
  },
  "build_args": {
    "NEXT_PUBLIC_ENABLE_DEMO_LOGIN": "false",
    "NEXT_PUBLIC_APP_URL": "https://your-app.zeabur.app"
  },
  "runtime_env": [
    "DATABASE_URL",
    "AUTH_SECRET",
    "AUTH_URL",
    "AUTH_TRUST_HOST"
  ]
}
