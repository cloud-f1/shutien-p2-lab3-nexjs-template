# ─── AI-Coding-Template — Production Template (Zeabur) ───────
# Set these as environment variables in Zeabur dashboard.
# DO NOT commit real secrets — this file is a reference template.

# ─── Database ─────────────────────────────────────────────────
# Zeabur provides this automatically when you add a PostgreSQL service
DATABASE_URL=postgresql+asyncpg://<USER>:<PASSWORD>@<HOST>:5432/<DB>

# ─── JWT Secrets ──────────────────────────────────────────────
# REQUIRED — generate with: openssl rand -hex 32
# These MUST be different from each other in production.
SECRET_KEY=<GENERATE: openssl rand -hex 32>
REFRESH_SECRET_KEY=<GENERATE: openssl rand -hex 32>
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── Email ────────────────────────────────────────────────────
# Production: use "zeabur" (Zeabur Email Service) or "mailgun"
# "console" only for debugging — emails go to stdout
EMAIL_PROVIDER=zeabur
EMAIL_FROM=noreply@yourdomain.com
# For Mailgun:
# MAILGUN_API_KEY=key-xxxxxxxx
# MAILGUN_DOMAIN=mg.yourdomain.com
# For Zeabur:
ZEABUR_EMAIL_API_KEY=<SET_IN_ZEABUR_DASHBOARD>

# ─── Google OAuth2 ────────────────────────────────────────────
# GOOGLE_CLIENT_ID=your-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-secret

# ─── GitHub OAuth2 ────────────────────────────────────────────
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-secret

# ─── Stripe Billing ───────────────────────────────────────────
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Monitoring ───────────────────────────────────────────────
SENTRY_DSN=<YOUR_SENTRY_DSN>
APP_VERSION=1.0.0

# ─── Logging ──────────────────────────────────────────────────
# "json" recommended for production log aggregation
LOG_FORMAT=json

# ─── App ──────────────────────────────────────────────────────
DEBUG=false
ENVIRONMENT=production
ALLOWED_ORIGINS_STR=https://yourdomain.com
RATE_LIMIT_AUTH=15/minute
RATE_LIMIT_GENERAL=200/minute

# ─── Session Cleanup ─────────────────────────────────────────
SESSION_CLEANUP_INTERVAL_MINUTES=60
SESSION_RETENTION_DAYS=7
