# ─── Database ─────────────────────────────────────────────────
# PostgreSQL connection string (asyncpg driver for async SQLAlchemy)
DATABASE_URL=postgresql+asyncpg://saas_user:saas_pass@localhost:5432/saas_dev

# ─── JWT Secrets ──────────────────────────────────────────────
# REQUIRED — generate with: openssl rand -hex 32
# `make go` auto-generates these if you haven't set them.
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING
REFRESH_SECRET_KEY=CHANGE_ME_REFRESH_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── Google OAuth2 ────────────────────────────────────────────
# Optional — uncomment to enable Google sign-in
# Get credentials at https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=your-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-secret

# ─── GitHub OAuth2 ────────────────────────────────────────────
# Optional — uncomment to enable GitHub sign-in
# Get credentials at https://github.com/settings/developers
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-secret

# ─── Email ────────────────────────────────────────────────────
# Provider: "console" (dev — prints to stdout), "mailgun", or "zeabur"
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@example.com
# For Mailgun:
# MAILGUN_API_KEY=key-xxxxxxxx
# MAILGUN_DOMAIN=mg.yourdomain.com
# For Zeabur Email Service:
# ZEABUR_EMAIL_API_KEY=your-zeabur-email-key

# ─── Monitoring (E159) ──────────────────────────────────────
# Server Sentry DSN. REQUIRED in production (startup fails fast if missing).
# Empty in dev/staging is a silent no-op — Sentry simply does not initialise.
# Legacy SENTRY_DSN is also read for backwards compat.
# SENTRY_DSN_SERVER=https://examplePublicKey@o0.ingest.sentry.io/0
# Build-time commit SHA — used as the Sentry `release` tag so stack
# traces deep-link to the exact commit. Set in CI / Zeabur:
#   GIT_SHA=$(git rev-parse --short HEAD)
# GIT_SHA=
APP_VERSION=0.1.0

# ─── Logging ─────────────────────────────────────────────────
# "console" for human-readable, "json" for structured (production)
LOG_FORMAT=console

# ─── App ─────────────────────────────────────────────────────
DEBUG=true
ENVIRONMENT=development
# Comma-separated list of allowed CORS origins
# Dev: Vite (:5173) + nginx/Docker (:3000)
ALLOWED_ORIGINS_STR=http://localhost:3000,http://localhost:5173
RATE_LIMIT_AUTH=15/minute
RATE_LIMIT_GENERAL=200/minute

# ─── Test Helpers (E150) ────────────────────────────────────
# Triple-guarded seed endpoints for E2E tests (Playwright).
# NEVER enable in production — Gate 2 blocks it anyway.
ENABLE_TEST_HELPERS=false

# ─── Stripe Billing ─────────────────────────────────────────
# Optional — uncomment to enable Stripe billing
# Get keys at https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
